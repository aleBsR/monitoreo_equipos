# Bytecode de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
.venv/
venv/
env/

# Dependencias Node (se reinstalan con npm install, miles de archivos)
node_modules/

# Builds generados (se recompilan en cada máquina con npm run build)
web/dist/
mobile/dist/

# Archivos de registro generados por los agentes
*.log
*.log.old
agent/historial_comandos.log

# Config local del agente (IP del servidor: distinta en cada equipo cliente)
agent/config.ini

# Sistema operativo / editores
.DS_Store
.idea/
*.swp

# Expo (estado local del Metro, no commitear)
.expo/
mobile/.expo/
