# Bytecode de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
.venv/
venv/
env/

# Dependencias Node (se reinstalan con npm install, miles de archivos)
node_modules/

# Builds generados (se recompilan en cada máquina con npm run build)
web/dist/
mobile/dist/

# Archivos de registro generados por los agentes
*.log
*.log.old
agent/historial_comandos.log

# Config local del agente (IP del servidor: distinta en cada equipo cliente)
agent/config.ini

# Sistema operativo / editores
.DS_Store
.idea/
*.swp

# Expo (estado local del Metro, no commitear)
.expo/
mobile/.expo/

# Archivos de bloqueo de LibreOffice/Office
~$*

# Scratch del flujo de trabajo (ledger interno)
.superpowers/

# Skills / contexto de asistentes de IA (se mantienen locales, no se versionan)
.claude/
.opencode/

# Seguridad: certificados TLS, claves privadas y secretos. NUNCA versionar.
# Se generan localmente con scripts/gen_certs.py y se distribuyen a mano.
certs/
*.key
*.pem
# Usuarios con contraseñas hasheadas (se crean con scripts/set_password.py)
server/usuarios.json

# Carpeta docs/ completa: material de estudio y preparacion para la defensa,
# documentacion de referencia de la catedra (libro, diapositivas, enunciado),
# informes y exports. NO es parte del codigo: se mantiene LOCAL y no se versiona.
docs/
